# Plantilla local: copia a .env y completa credenciales/rutas reales.
# No pongas secretos en Git. run-local.ps1 carga este archivo para el proceso Maven.

EVALUATION_QUERY_API_PORT=8082

# Auth JWT: solo la pública de Auth; issuer debe coincidir con Auth y Scoring.
AUTH_JWT_ISSUER=crediticio-auth
EVALUATION_QUERY_JWT_PUBLIC_KEY_LOCATION=file:../auth/keys/jwt-publica.pem

# Misma BD de PostgreSQL que Scoring. Usa el rol de lectura/consulta, no el de Auth.
EVALUATION_QUERY_DB_URL=postgresql://localhost:5432/db_scoring
EVALUATION_QUERY_DB_USERNAME=consulta_app
EVALUATION_QUERY_DB_PASSWORD=CHANGE_ME
EVALUATION_QUERY_DB_SCHEMA=consulta
EVALUATION_QUERY_FLYWAY_MIGRAR_AL_ARRANCAR=false

# Catálogo versionado incluido con la aplicación.
EVALUATION_QUERY_CATALOGO_LOCATION=classpath:catalogo/recomendaciones.json

# Saga de recomendaciones Scoring -> Query. Deshabilitada por defecto.
EVALUATION_QUERY_SAGA_HABILITADA=false
SCORING_SERVICE_JWT_ISSUER=scoring-api
SCORING_SERVICE_JWT_KEY_ID=local-scoring-service-v1
SCORING_SERVICE_JWT_PUBLIC_KEY_LOCATION=file:../scoring-api/keys-service/scoring-service-public.pem
SCORING_SERVICE_JWT_PREVIOUS_KEY_ID=
SCORING_SERVICE_JWT_PREVIOUS_PUBLIC_KEY_LOCATION=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Solo durante migraciones controladas del esquema consulta; no para arranques diarios.
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
